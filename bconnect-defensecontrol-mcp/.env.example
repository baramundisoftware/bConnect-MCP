# bConnect API Configuration
# API Documentation: https://your-baramundi-server.example.com/bconnect/docs/
BCONNECT_BASE_URL=https://your-baramundi-server.example.com/bconnect

# Authentication — choose one method:
# Option 1: Basic Auth (username + password)
BCONNECT_USERNAME=your-username
BCONNECT_PASSWORD=your-password
# Option 2: API Key (generated in bMS console under Server Management → API Keys)
# BCONNECT_API_KEY=your-api-key

# NOTE: this suite requires baramundi Management Suite 26R1 or later.
# Servers refuse to start against an older bMS (there is no BCONNECT_RELEASE
# setting any more — 25R2 is not supported).

# Optional: Path to a PEM-encoded CA certificate file used to verify the
# bConnect server's TLS certificate (e.g. a self-signed or internal CA cert).
# Set this instead of disabling TLS verification entirely.
# Example (Windows):     BCONNECT_CA_CERT_PATH=C:\ProgramData\bConnect-MCP\my-internal-ca.pem
# Example (Linux/macOS): BCONNECT_CA_CERT_PATH=/etc/ssl/certs/my-internal-ca.pem
BCONNECT_CA_CERT_PATH=

# Optional: HTTP timeout and retry behavior (defaults shown)
BCONNECT_TIMEOUT_MS=30000
BCONNECT_MAX_RETRIES=0
BCONNECT_RETRY_DELAY_MS=100

# DEVELOPMENT ONLY — NEVER USE IN PRODUCTION:
# NODE_TLS_REJECT_UNAUTHORIZED=0

## Production Security Settings
# SENSITIVE SERVER: Rate limiting and audit logging are enabled by default.
# The limiter counts HTTP REQUESTS, not tool calls, and one tool call is not one
# request: the composite tools (get_unpatched_endpoints, get_fleet_summary,
# get_vulnerability_exposure, get_security_posture, diagnose_job) fan out into
# paged walks whose length follows the size of YOUR estate. It has no queue and
# no backoff, and BCONNECT_MAX_RETRIES defaults to 0 — an empty bucket THROWS,
# failing the tool call where it stands, possibly halfway through a walk.
#
# 2500 is the sum of the page ceilings one cold get_unpatched_endpoints can
# reach (CVE-library, detections, endpoint and job-history walks), rounded up.
# It is a runaway guard, ~42 requests/second across the window, not a throttle:
# any smaller value is smaller than a single composite call, and the first
# analytical question asked against a real estate dies partway through.
BCONNECT_RATE_LIMIT_ENABLED=true
BCONNECT_RATE_LIMIT_MAX_REQUESTS=2500
BCONNECT_RATE_LIMIT_WINDOW_MS=60000

# Audit logging level: none | security | write | all
# Sensitive server: audit logging enabled by default to track defense control changes
BCONNECT_AUDIT_LEVEL=all

# Include tool call parameters (redacted) in audit log entries.
BCONNECT_AUDIT_INCLUDE_PARAMS=false

## MCP Transport
# Transport mode: stdio (default, for any MCP client that launches the server
# itself) or http (for remote / Docker deployments)
MCP_TRANSPORT=stdio
# HTTP port (only used when MCP_TRANSPORT=http)
# MCP_PORT=3000

# Secret-read gate (security audit C3): get_bitlocker_secrets and
# get_local_admin_accounts return live credentials (BitLocker keys/PIN, LAPS
# passwords). Off by default so they cannot leak into an LLM context. Set to
# true only where retrieving these secrets is an intended, authorized use.
ALLOW_SECRET_READ=false

# Write gate: enables this server's create/update/delete/start tools.
# Off by default so writes cannot happen accidentally. Set to true only
# for an environment sanctioned for live writes.
ALLOW_WRITE_OPERATIONS=false

# Wall-clock ceiling for a single composite tool call, in milliseconds
# (default 25000). The composite tools walk paged collections whose size is set
# by your estate, so on a large one they can run longer than the caller will
# wait. When the budget is spent the tool returns what it has, and says so,
# rather than being killed mid-walk and returning nothing. Set this BELOW your
# MCP client's own tool-call timeout — an honest partial answer is worth more
# than a timeout.
# BCONNECT_COMPOSITE_BUDGET_MS=25000
