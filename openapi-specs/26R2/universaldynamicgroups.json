{
  "openapi": "3.0.4",
  "info": {
    "title": "bConnect Universal Dynamic Groups API",
    "description": "Universal Dynamic groups are summaries of target systems.Their groupings are independent of logical groups, so a target system can be a member of a logical and a dynamic group at the same time.(see <a target=\"_blank\" href=\"https://docs.baramundi.com/helpsetid=m_environment&externalid=k_obj_environment_dynamic-groups_dynamic-group-universal&\" rel=\"noopener noreferrer\" class=\"link\"><span class=\"url\"> documentation</span></a>). \n\nThe bConnect V2 PowerShell module is available from the <a target=\"_blank\" href=\"https://www.powershellgallery.com/packages/bConnectV2\" rel=\"noopener noreferrer\" class=\"link\"><span class=\"url\">PowerShell Gallery</span></a>.",
    "version": "2.0"
  },
  "paths": {
    "/v2.0/Thresholds": {
      "get": {
        "tags": [
          "Thresholds"
        ],
        "summary": "Gets all configured thresholds",
        "description": "Powershell function: `Get-bCUniversaldynamicgroupsThresholds`",
        "operationId": "GetThresholds",
        "parameters": [
          {
            "name": "OrderBy",
            "in": "query",
            "description": "Sorts results by property name and sort direction. Multiple properties are separated by comma. Possible values are DynamicGroupName, SecurityProfileName, Severity, Value, Type, and IsActive (e. g. DynamicGroupName asc).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SearchQuery",
            "in": "query",
            "description": "Filters results by matching the given value against searchable properties. Searchable values are DynamicGroupName, SecurityProfileName and Comment.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "description": "The zero-indexed number of the first page that begins the set of pages that are returned in the response.",
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "x-bConnect-page-parameter": true
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "The number of items to list on a single page. For example, if page_size is 10, each page shows ten items. <br />A valid value is a non-negative, non-zero integer. The default value is 20. Maximum value is 1000.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "Returns all thresholds the caller is allowed to read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThresholdPagedList"
                }
              }
            }
          }
        },
        "x-powershell-method-name": "Get-bCUniversaldynamicgroupsThresholds",
        "x-bConnect-returns-paged-list": true
      },
      "post": {
        "tags": [
          "Thresholds"
        ],
        "summary": "Creates a new threshold on a universal dynamic group",
        "description": "Powershell function: `New-bCUniversaldynamicgroupsThreshold`",
        "operationId": "CreateThreshold",
        "requestBody": {
          "description": "The threshold to be created\n\nInitialize in PowerShell with `Initialize-bCUniversaldynamicgroupsThresholdForCreation`",
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ThresholdForCreation"
                  }
                ],
                "description": "A threshold to be created on a universal dynamic group"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "The threshold could not be created due to invalid input data",
