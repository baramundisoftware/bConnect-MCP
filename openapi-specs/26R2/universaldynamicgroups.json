              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "201": {
            "description": "Threshold successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Threshold"
                }
              }
            }
          },
          "403": {
            "description": "Modify rights are missing for the universal dynamic group or the caller is not in the role matching the security profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The universal dynamic group or the security profile does not exist or is not visible due to missing read rights",
