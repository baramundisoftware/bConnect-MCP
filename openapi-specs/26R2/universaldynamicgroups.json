      "patch": {
        "tags": [
          "Thresholds"
        ],
        "summary": "Updates the modifiable values of the threshold with the specified id",
        "description": "Powershell function: `Update-bCUniversaldynamicgroupsThreshold`",
        "operationId": "UpdateThreshold",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "guid"
            }
          }
        ],
        "requestBody": {
          "description": "A JSON Patch document consists of a set of operations that allow specific partial changes to an object. The example document contains all modifiable threshold properties. The universal dynamic group and security profile can not be changed.\n\nInitialize patch operations in PowerShell with `Initialize-bCPatchOperation`",
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/JsonPatchDocument"
              },
              "example": [
                {
                  "value": 100,
                  "path": "/Value",
                  "op": "replace"
                },
                {
                  "value": "UpperLimit",
                  "path": "/Type",
                  "op": "replace"
                },
                {
                  "value": "Warning",
                  "path": "/Severity",
                  "op": "replace"
                },
                {
                  "value": true,
                  "path": "/IsActive",
                  "op": "replace"
                },
                {
                  "value": "New comment",
                  "path": "/Comment",
                  "op": "replace"
                }
              ]
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "The specified values to be modified are invalid",
