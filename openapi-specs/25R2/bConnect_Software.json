{
  "openapi": "3.0.1",
  "info": {
    "title": "bConnect Software API",
    "description": "<p>Software is a core component of the baramundi Management Suite.<br><br>Currently, this API provides means to query which software is installed on Windows endpoints.</p>",
    "version": "2.0"
  },
  "servers": [
    {
      "url": "https://bms.example.com:444/bconnect/software"
    }
  ],
  "paths": {
    "/v2.0/InstalledWindowsSoftware": {
      "get": {
        "tags": [
          "InstalledWindowsSoftware"
        ],
        "summary": "Gets all installed Windows software",
        "operationId": "GetInstalledWindowsSoftware",
        "parameters": [
          {
            "name": "SearchQuery",
            "in": "query",
            "description": "Filters results by matching the given value against searchable properties.<br />Searchable value is Vendor, Name, Category.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "OrderBy",
            "in": "query",
            "description": "Sorts results by property name and with sort direction. Multiple properties are separated by comma.<br />Possible values are Vendor, Name, Category (e.g. Name asc).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Category",
            "in": "query",
            "description": "Filters results by exactly matching category.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "description": "The zero-indexed number of the first page that begins the set of pages that are returned in the response.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "The number of items to list on a single page. For example, if page_size is 10, each page shows ten items. <br />A valid value is a non-negative, non-zero integer. The default value is 20. Maximum value is 1000.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "Returns installed software for all Windows endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstalledWindowsSoftwarePagedList"
                }
              }
            }
          }
        }
      }
    },
