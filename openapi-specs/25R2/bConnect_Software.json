  "components": {
    "schemas": {
      "InstalledWindowsSoftware": {
        "type": "object",
        "properties": {
          "vendor": {
            "type": "string",
            "description": "The vendor of the software",
            "nullable": true
          },
          "name": {
            "type": "string",
            "description": "The name of the software"
          },
          "version": {
            "type": "string",
            "description": "The version of the software",
            "nullable": true
          },
          "category": {
            "type": "string",
            "description": "The user defined category of the software",
            "nullable": true
          },
          "source": {
            "allOf": [
              {
                "$ref": "#/components/schemas/InstalledWindowsSoftwareSource"
              }
            ],
            "description": "How the software is managed on the device by the bMS"
          },
          "installed": {
            "type": "string",
            "description": "When the software was installed",
            "format": "date-time",
            "nullable": true
          },
          "lastFound": {
            "type": "string",
            "description": "When the software was found the last time on the endpoint",
            "format": "date-time",
            "nullable": true
          },
          "applicationId": {
            "type": "string",
            "description": "The id of the associated Windows application",
            "format": "guid",
            "nullable": true
          },
          "detectionRuleId": {
            "type": "string",
            "description": "The id of the associated software detection rule",
            "format": "guid",
            "nullable": true
          },
          "endpointId": {
            "type": "string",
            "description": "The id of the endpoint",
            "format": "guid",
            "nullable": true
          },
          "endpointName": {
            "type": "string",
            "description": "The name of the endpoint",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "InstalledWindowsSoftwarePagedList": {
        "type": "object",
        "properties": {
          "currentPage": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "readOnly": true
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "readOnly": true
          },
          "totalPages": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "readOnly": true
          },
          "totalItems": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "hasPreviousPage": {
            "type": "boolean",
            "readOnly": true
          },
          "hasNextPage": {
            "type": "boolean",
            "readOnly": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InstalledWindowsSoftware"
            },
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "InstalledWindowsSoftwareSource": {
        "enum": [
          "Unknown",
          "Inventoried",
          "Installed",
          "ManagedSoftware"
        ],
        "type": "string"
      },
      "JsonPatchDocument": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Operation"
        },
        "description": "Array of operations to perform"
      },
      "Operation": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string"
          },
          "value": {
            "type": "object",
            "nullable": true
          },
          "path": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "description": "Input your username and password to access this API",
        "scheme": "basic"
      }
    }
  },
  "security": [
