{
  "openapi": "3.0.1",
  "info": {
    "title": "bConnect Operating Systems API",
    "description": "<p>Operating systems can be installed fully automatically, quickly and reliably. Endpoints can be partitioned, formatted, installed and configured in a single pass (see <a href=\"https://docs.baramundi.com/helpsetid=m_operating-systems&amp;externalid=k_operating-systems\">documentation</a>).<br> <br>The methods provided allow reading general operating system information as well as managing the operating system installation configuration of Windows endpoints.</p>",
    "version": "2.0"
  },
  "servers": [
    {
      "url": "https://bms.example.com:444/bconnect/operatingsystems"
    }
  ],
  "paths": {
    "/v2.0/Folders": {
      "get": {
        "tags": [
          "Folders"
        ],
        "summary": "Gets all folders",
        "operationId": "GetFolders",
        "parameters": [
          {
            "name": "OrderBy",
            "in": "query",
            "description": "Sorts results by property name and with sort direction. Multiple properties are separated by comma.<br />Possible value is Name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SearchQuery",
            "in": "query",
            "description": "Filters results by matching the given value against searchable properties.<br />Searchable values are Name and Comment.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Name",
            "in": "query",
            "description": "Filters result by matching the exact value against Name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "description": "The zero-indexed number of the first page that begins the set of pages that are returned in the response.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "The number of items to list on a single page. For example, if page_size is 10, each page shows ten items. <br />A valid value is a non-negative, non-zero integer. The default value is 20. Maximum value is 1000.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "Returns all folders",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderPagedList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Folders"
        ],
        "summary": "Creates a folder according to the specified properties",
        "operationId": "CreateFolder",
        "requestBody": {
          "description": "The folder to be created",
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/FolderForCreation"
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "201": {
            "description": "Creates the folder",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Folder"
                }
              }
            }
          },
          "403": {
            "description": "Object creation rights are missing for parent object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Either invalid input or the parent of the folder does not exist or is not visible due to missing read rights",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "A value was tried to be set twice where duplicates are not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v2.0/Folders/{id}": {
      "get": {
        "tags": [
          "Folders"
        ],
        "summary": "Gets a folder by id",
        "operationId": "GetFolder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "guid"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "Returns the folder with the specified id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Folder"
                }
              }
            }
          },
          "404": {
            "description": "A folder with the specified id does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Folders"
        ],
        "summary": "Updates a folder according to the specified properties",
        "operationId": "UpdateFolder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "guid"
            }
          }
        ],
        "requestBody": {
          "description": "A JSON Patch document consists of a set of operations that allow specific partial changes to an object. The example document contains all modifiable folder properties.",
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/JsonPatchDocument"
              },
              "example": [{"value":"My operating system folder","path":"/name","op":"replace"},{"value":"cf524068-9543-4163-94f1-de2f8b18d975","path":"/parentId","op":"replace"},{"value":"This is an example comment.","path":"/comment","op":"replace"}]
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Invalid input or the folder can not be changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "Updates the folder",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Folder"
                }
              }
            }
          },
          "403": {
            "description": "Object modify rights are missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Either invalid input or the folder does not exist or is not visible due to missing read rights",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "A value was tried to be set twice where duplicates are not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Folders"
        ],
        "summary": "Deletes a folder by id",
        "operationId": "DeleteFolder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "guid"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Folder is not empty or can not be deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "204": {
            "description": "Folder successfully deleted or does not exist"
          },
          "403": {
            "description": "Delete rights are missing for folder",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v2.0/Folders/{folderId}/Folders": {
      "get": {
        "tags": [
          "Folders"
        ],
        "summary": "Gets all folders contained by a folder",
        "operationId": "GetFoldersByFolderId",
        "parameters": [
          {
            "name": "folderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "guid"
            }
          },
          {
            "name": "OrderBy",
            "in": "query",
            "description": "Sorts results by property name and with sort direction. Multiple properties are separated by comma.<br />Possible value is Name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SearchQuery",
            "in": "query",
            "description": "Filters results by matching the given value against searchable properties.<br />Searchable values are Name and Comment.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Name",
            "in": "query",
            "description": "Filters result by matching the exact value against Name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "description": "The zero-indexed number of the first page that begins the set of pages that are returned in the response.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "The number of items to list on a single page. For example, if page_size is 10, each page shows ten items. <br />A valid value is a non-negative, non-zero integer. The default value is 20. Maximum value is 1000.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "includeSubfolders",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "Returns the folders contained in a specified folder",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderPagedList"
                }
              }
            }
          },
          "404": {
            "description": "The specified folder can not be found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v2.0/WindowsEndpoints": {
      "get": {
        "tags": [
          "WindowsEndpoints"
        ],
        "summary": "Gets OS install information for all windows endpoints",
        "operationId": "GetWindowsEndpoints",
        "parameters": [
          {
            "name": "OrderBy",
            "in": "query",
            "description": "Sorts results by property name and with sort direction. Multiple properties are separated by comma.<br />Possible values are EndpointId or EndpointName.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SearchQuery",
            "in": "query",
            "description": "Filters results by matching the given value against searchable properties.<br />Searchable values are EndpointName.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "description": "The zero-indexed number of the first page that begins the set of pages that are returned in the response.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "The number of items to list on a single page. For example, if page_size is 10, each page shows ten items. <br />A valid value is a non-negative, non-zero integer. The default value is 20. Maximum value is 1000.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "Returns all found windows endpoints",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WindowsEndpointPagedList"
                }
              }
            }
          }
        }
      }
    },
    "/v2.0/WindowsEndpoints/{id}": {
      "get": {
        "tags": [
          "WindowsEndpoints"
        ],
        "summary": "Gets OS install information for a specific windows endpoint",
        "operationId": "GetWindowsEndpoint",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "guid"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "Returns a OS install windows endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WindowsEndpoint"
                }
              }
            }
          },
          "404": {
            "description": "A windows endpoint with the specified id does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "WindowsEndpoints"
        ],
        "summary": "Sets the windows endpoint OS install configuration",
        "operationId": "UpdateWindowsEndpoint",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "guid"
            }
          }
        ],
        "requestBody": {
          "description": "A JSON Patch document consists of a set of operations that allow specific partial changes to an object. The example document contains all modifiable Windows endpoint properties concerning operating systems.",
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/JsonPatchDocument"
              },
              "example": [{"value":"671BBBED-BF25-4FAA-83FF-F5ABFDFD3F95","path":"/bootEnvironmentId","op":"replace"},{"value":"031D347A-3193-4300-AEE1-C27B9F23C45D","path":"/hardwareProfileId","op":"replace"},{"value":"true","path":"/isOSInstallAllowed","op":"replace"},{"value":"false","path":"/inheritsAutoInstallation","op":"replace"},{"value":{"localeId":1033},"path":"/operatingSystem","op":"replace"}]
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "Updates an windows endpoint according to the specified properties",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WindowsEndpoint"
                }
              }
            }
          },
          "403": {
            "description": "Modify rights are missing for the endpoint object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Either invalid input or the endpoint does not exist or is not visible due to missing read rights",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Folder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the folder",
            "format": "guid"
          },
          "name": {
            "type": "string",
            "description": "The name of the folder"
          },
          "comment": {
            "type": "string",
            "description": "The comment of the folder",
            "nullable": true
          },
          "parentId": {
            "type": "string",
            "description": "The id of the parent folder",
            "format": "guid"
          },
          "parent": {
            "type": "string",
            "description": "The name of the parent folder"
          }
        },
        "additionalProperties": false
      },
      "FolderForCreation": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string",
            "description": "The name of the folder"
          },
          "parentId": {
            "type": "string",
            "description": "The parent of the folder",
            "format": "guid",
            "nullable": true
          },
          "comment": {
            "type": "string",
            "description": "The comment of the folder",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "FolderPagedList": {
        "type": "object",
        "properties": {
          "currentPage": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "readOnly": true
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "readOnly": true
          },
          "totalPages": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "readOnly": true
          },
          "totalItems": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "hasPreviousPage": {
            "type": "boolean",
            "readOnly": true
          },
          "hasNextPage": {
            "type": "boolean",
            "readOnly": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Folder"
            },
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "JsonPatchDocument": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Operation"
        },
        "description": "Array of operations to perform"
      },
      "OSVersion": {
        "type": "object",
        "properties": {
          "full": {
            "type": "string",
            "description": "The full version name of the installed OS",
            "nullable": true
          },
          "major": {
            "type": "integer",
            "description": "Major version of the installed OS",
            "format": "int32"
          },
          "minor": {
            "type": "integer",
            "description": "Minor version of the installed OS",
            "format": "int32"
          },
          "build": {
            "type": "integer",
            "description": "Build number of the installed OS",
            "format": "int32"
          },
          "patchLevel": {
            "type": "integer",
            "description": "Patch level of the operating system (Revision ID).<br />Applies for Windows 10 systems only.",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "Operation": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string"
          },
          "value": {
            "type": "object",
            "nullable": true
          },
          "path": {
            "type": "string"
          }
        }
      },
      "OperationType": {
        "enum": [
          "Add",
          "Remove",
          "Replace",
          "Move",
          "Copy",
          "Test",
          "Invalid"
        ],
        "type": "string"
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "WindowsEndpoint": {
        "type": "object",
        "properties": {
          "endpointId": {
            "type": "string",
            "description": "The id of the endpoint",
            "format": "guid"
          },
          "endpointName": {
            "type": "string",
            "description": "The name of the endpoint"
          },
          "bootEnvironmentId": {
            "type": "string",
            "description": "If set, the giving boot environment will boot during the next start.<br />For booting without PXE, this value must be left empty.",
            "format": "guid",
            "nullable": true
          },
          "hardwareProfileId": {
            "type": "string",
            "description": "The hardware profile‘s ID of an endpoint",
            "format": "guid",
            "nullable": true
          },
          "isOSInstallAllowed": {
            "type": "boolean",
            "description": "If set to true, OS installation is admitted"
          },
          "inheritsAutoInstallation": {
            "type": "boolean",
            "description": "If set to true, auto installation is inherited"
          },
          "operatingSystem": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WindowsOperatingSystem"
              }
            ],
            "description": "The device's operating system",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "WindowsEndpointPagedList": {
        "type": "object",
        "properties": {
          "currentPage": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "readOnly": true
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
