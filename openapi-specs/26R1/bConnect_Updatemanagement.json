{
  "openapi": "3.0.4",
  "info": {
    "title": "bConnect Update Management API",
    "description": "<p>Update management is the inventory and distribution of updates available for an operating system or components installed on it. Update management for Windows endpoints includes all updates provided by Microsoft for installation by the Windows Update Agent either through one of their online update catalogs (Windows Update, Microsoft Update) or a customer-operated WSUS.</p><p>Currently, this API provides means to query aggregated metadata about the update status of Windows endpoints, as well as the timeliness of that data. In addition, a device can be assigned a so-called update profile (see <a href=\"https://docs.baramundi.com/helpsetid=m_update-management&externalid=r_update-mgt_update-profiles\">documentation</a>), which can be used to control which updates are allowed for the device and in which time window the updates must be installed to keep the device <i>compliant</i>.</p>\n\nThe bConnect V2 PowerShell module is available from the <a target=\"_blank\" href=\"https://www.powershellgallery.com/packages/bConnectV2\" rel=\"noopener noreferrer\" class=\"link\"><span class=\"url\">PowerShell Gallery</span></a>.",
    "version": "2.0"
  },
  "servers": [
    {
      "url": "https://bms.example.com:444/bconnect/updatemanagement"
    }
  ],
  "paths": {
    "/v2.0/WindowsEndpoints": {
      "get": {
        "tags": [
          "WindowsEndpoints"
        ],
        "summary": "Get information concerning Microsoft Update Management for all windows endpoints",
        "description": "Powershell function: `Get-bCUpdatemanagementWindowsEndpoints`",
        "operationId": "GetWindowsEndpoints",
        "parameters": [
          {
            "name": "OrderBy",
            "in": "query",
            "description": "Sorts results by property name and with sort direction. Multiple properties are separated by comma.<br />Possible values are EndpointName, LastInventory and LastSuccessfulUpdate.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SearchQuery",
            "in": "query",
            "description": "Filters results by matching the given value against searchable properties.<br />Searchable values are EndpointName and UpdateProfileName.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "description": "The zero-indexed number of the first page that begins the set of pages that are returned in the response.",
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "x-bConnect-page-parameter": true
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "The number of items to list on a single page. For example, if page_size is 10, each page shows ten items. <br />A valid value is a non-negative, non-zero integer. The default value is 20. Maximum value is 1000.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "Returns all found Microsoft Update Management states",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WindowsEndpointPagedList"
                }
              }
            }
          }
        },
        "x-powershell-method-name": "Get-bCUpdatemanagementWindowsEndpoints",
        "x-bConnect-returns-paged-list": true
      }
    },
    "/v2.0/WindowsEndpoints/{id}": {
      "get": {
        "tags": [
          "WindowsEndpoints"
        ],
        "summary": "Get information concerning Microsoft Update Management for a specific windows endpoint",
        "description": "Powershell function: `Get-bCUpdatemanagementWindowsEndpoint`",
        "operationId": "GetWindowsEndpoint",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "guid"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "Returns current Microsoft Update Management state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WindowsEndpoint"
                }
              }
            }
          },
          "404": {
            "description": "A windows endpoint with the specified id does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-powershell-method-name": "Get-bCUpdatemanagementWindowsEndpoint"
      },
      "patch": {
        "tags": [
          "WindowsEndpoints"
        ],
        "summary": "Sets Microsoft Update Management update profile for windows endpoint. Can be resetted with null as given value.",
        "description": "Powershell function: `Update-bCUpdatemanagementWindowsEndpoint`",
        "operationId": "UpdateWindowsEndpoint",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "guid"
            }
          }
        ],
        "requestBody": {
          "description": "A JSON Patch document consists of a set of operations that allow specific partial changes to an object. The example document contains all modifiable Windows endpoint properties concerning update management.\n\nInitialize patch operations in PowerShell with `Initialize-bCPatchOperation`",
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/JsonPatchDocument"
              },
              "example": [{"value":"671BBBED-BF25-4FAA-83FF-F5ABFDFD3F95","path":"/updateProfileId","op":"replace"}]
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "Update profile was successfully set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WindowsEndpoint"
                }
              }
            }
          },
          "403": {
            "description": "Modify rights are missing for the endpoint object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "A Windows endpoint and/or update profile with the respective specified id either does not exist or is not visible due to missing rights",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-powershell-method-name": "Update-bCUpdatemanagementWindowsEndpoint"
      }
    }
  },
  "components": {
    "schemas": {
      "JsonPatchDocument": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Operation"
        },
        "description": "Array of operations to perform"
      },
      "Operation": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string"
          },
          "value": {
            "type": "object",
            "nullable": true
          },
          "path": {
            "type": "string"
          }
        }
      },
      "OperationType": {
        "enum": [
          "Add",
          "Remove",
          "Replace",
          "Move",
          "Copy",
          "Test",
          "Invalid"
        ],
        "type": "string"
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "UpdateDownloadMode": {
        "enum": [
          "Unknown",
          "NotSupported",
          "HttpOnly",
          "HttpBlendedWithPeeringBehindSameNat",
          "HttpBlendedWithPeeringAcrossPrivateGroup",
          "HttpBlendedWithInternetPeering",
          "SimpleDownloadModeNoPeering",
          "BypassMode"
        ],
        "type": "string",
        "description": "HttpOnly: HTTP only, no peering<br />HttpBlendedWithPeeringBehindSameNat: HTTP blended with peering behind the same NAT<br />HttpBlendedWithPeeringAcrossPrivateGroup: HTTP blended with peering across a private group.Peering occurs on devices in the same Active Directory Site(if exist) or the same domain by default.<br />When this option is selected, peering will cross NATs. To create a custom group use Group ID in combination with Mode 2.<br />HttpBlendedWithInternetPeering: HTTP blended with Internet Peering.<br />SimpleDownloadModeNoPeering: Simple download mode with no peering. Delivery Optimization downloads using HTTP only and does not attempt to contact the Delivery Optimization cloud services.<br />BypassMode: Bypass mode. Do not use Delivery Optimization and use BITS instead."
      },
      "UpdateDownloadSource": {
        "enum": [
          "Unknown",
          "WSUS",
          "WindowsOnline",
          "MicrosoftOnline"
        ],
        "type": "string"
      },
      "UpdateState": {
        "enum": [
          "Unknown",
          "InventoryOutdated",
          "NonCompliant",
          "Compliant"
        ],
        "type": "string"
      },
      "WindowsEndpoint": {
        "type": "object",
        "properties": {
          "endpointId": {
            "type": "string",
            "description": "The id of the endpoint",
            "format": "guid"
          },
          "endpointName": {
            "type": "string",
            "description": "The name of the endpoint"
          },
          "updateProfileId": {
            "type": "string",
            "description": "The assigned Microsoft Update Profile id",
            "format": "guid",
            "nullable": true
          },
          "updateProfileName": {
            "type": "string",
            "description": "The assigned Microsoft Update Profile name",
            "nullable": true
          },
          "missingCriticalUpdates": {
            "type": "integer",
            "description": "The number of missing critical (defined by bMS) updates",
            "format": "int32",
            "nullable": true
          },
          "missingSecurityUpdates": {
            "type": "integer",
            "description": "The number of missing security (defined by bMS) updates",
            "format": "int32",
            "nullable": true
          },
          "missingOtherUpdates": {
            "type": "integer",
            "description": "The number of missing updates, which are neither critical nor security updates",
            "format": "int32",
            "nullable": true
          },
          "updateDownloadMode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UpdateDownloadMode"
              }
            ],
            "description": "The Windows Update download mode"
          },
          "lastInventory": {
            "type": "string",
            "description": "The date and time of the last executed update inventory",
            "format": "date-time",
            "nullable": true
          },
          "lastInventorySource": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UpdateDownloadSource"
              }
            ],
            "description": "The update metadata source of the last inventory"
          },
          "lastSuccessfulUpdate": {
            "type": "string",
            "description": "The date and time of the last successfully executed update deploy job step<br />(only applies to update job steps controlling the Windows Update Agent)",
            "format": "date-time",
            "nullable": true
          },
          "lastSuccessfulUpdateSource": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UpdateDownloadSource"
              }
            ],
            "description": "The update metadata source of the last successful update deploy job step"
          },
          "deferredUpdates": {
            "type": "integer",
            "description": "The number of deferred updates",
            "format": "int32",
            "nullable": true
          },
          "blockedUpdates": {
            "type": "integer",
            "description": "The number of blocked updates",
            "format": "int32",
            "nullable": true
          },
          "featureUpdatesAvailable": {
            "type": "boolean",
            "description": "Idicates that some feature updates are available for installation",
            "nullable": true
          },
          "updateState": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UpdateState"
              }
            ],
            "description": "Update status of a client. If an update inventory has not yet been performed on the endpointor no update profile is assigned, the state is Unknown."
          },
          "targetReleaseVersion": {
            "type": "string",
            "description": "The version string of the targeted release",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "WindowsEndpointPagedList": {
        "type": "object",
        "properties": {
          "currentPage": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "readOnly": true
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "readOnly": true
          },
          "totalPages": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "readOnly": true
          },
          "totalItems": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "hasPreviousPage": {
            "type": "boolean",
            "readOnly": true
          },
          "hasNextPage": {
            "type": "boolean",
            "readOnly": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WindowsEndpoint"
            },
            "readOnly": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "description": "Input your username and password to access this API",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": [ ]
    }
  ],
  "tags": [
    {
      "name": "WindowsEndpoints",
      "description": "Manages Microsoft Update Management configuration and information for windows endpoints"
    }
  ]
}