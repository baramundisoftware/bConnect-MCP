{
  "openapi": "3.0.4",
  "info": {
    "title": "bConnect Compliance API",
    "description": "<p>Devices managed by the baramundi Management Suite can be scanned and checked for security-related information such as vulnerabilities and configuration violations.<br>The provided APIs allow you to query vulnerabilities detected on Windows endpoints, including detailed metadata such as CVE ID, description, severity, score, affected operating systems and products.<br>Likewise, configuration violations identified for Android, iOS and macOS endpoints can be retrieved along with metadata such as description, severity and type.</p>\n\nThe bConnect V2 PowerShell module is available from the <a target=\"_blank\" href=\"https://www.powershellgallery.com/packages/bConnectV2\" rel=\"noopener noreferrer\" class=\"link\"><span class=\"url\">PowerShell Gallery</span></a>.",
    "version": "2.0"
  },
  "servers": [
    {
      "url": "https://bms.example.com:444/bconnect/compliance"
    }
  ],
  "paths": {
    "/v2.0/DetectedRuleViolations": {
      "get": {
        "tags": [
          "DetectedRuleViolations"
        ],
        "summary": "Gets all detected rule violations for Android, iOS and macOS endpoints",
        "description": "Powershell function: `Get-bCComplianceDetectedRuleViolations`",
        "operationId": "GetDetectedRuleViolations",
        "parameters": [
          {
            "name": "OrderBy",
            "in": "query",
            "description": "Sorts results by property name and with sort direction. Multiple properties are separated by comma.<br />Possible values are EndpointName or RuleName (e.g. RuleName asc).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SearchQuery",
            "in": "query",
            "description": "Filters results by matching the given value against searchable properties.<br />Searchable values are EndpointName or RuleName.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "description": "The zero-indexed number of the first page that begins the set of pages that are returned in the response.",
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "x-bConnect-page-parameter": true
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "The number of items to list on a single page. For example, if page_size is 10, each page shows ten items. <br />A valid value is a non-negative, non-zero integer. The default value is 20. Maximum value is 1000.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "Returns all detected rule violations for Android, iOS and macOS endpoints",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuleViolationPagedList"
                }
              }
            }
          }
        },
        "x-powershell-method-name": "Get-bCComplianceDetectedRuleViolations",
        "x-bConnect-returns-paged-list": true
      }
    },
