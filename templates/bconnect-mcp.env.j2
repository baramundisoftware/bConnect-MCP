# bConnect API Configuration
BCONNECT_API_URL={{ bconnect_api_url }}
BCONNECT_API_KEY={{ bconnect_api_key }}

# Optional: If using username/password authentication instead of API key
{% if bconnect_username is defined %}
BCONNECT_USERNAME={{ bconnect_username }}
{% endif %}
{% if bconnect_password is defined %}
BCONNECT_PASSWORD={{ bconnect_password }}
{% endif %}

# Optional: OpenAPI Spec URL
{% if bconnect_openapi_url is defined %}
BCONNECT_OPENAPI_URL={{ bconnect_openapi_url }}
{% endif %}
