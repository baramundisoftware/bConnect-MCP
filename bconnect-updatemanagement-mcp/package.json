{
  "name": "bconnect-updatemanagement-mcp",
  "version": "26.1.0",
  "description": "MCP server for baramundi bConnect Update Management \u2014 Windows endpoint update profile management",
  "type": "module",
  "main": "build/index.js",
  "bin": "build/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js",
    "pkg": "pkg . --targets node20-win-x64 --output dist/bconnect-updatemanagement-mcp.exe --compress GZip",
    "pkg:win": "pkg . --targets node20-win-x64 --output dist/bconnect-updatemanagement-mcp.exe --compress GZip",
    "pkg:all": "pkg . --targets node20-win-x64,node20-linux-x64,node20-macos-x64 --compress GZip"
  },
  "pkg": {
    "targets": [
      "node20-win-x64"
    ],
    "assets": [],
    "outputPath": "dist"
  },
  "keywords": [
    "mcp",
    "baramundi",
    "bconnect",
    "model-context-protocol",
    "update-management",
    "windows-updates"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.0",
    "axios-retry": "^4.5.0",
    "dotenv": "^16.4.0",
    "limiter": "^3.0.0",
    "node-cache": "^5.1.2",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "@vitest/coverage-v8": "^3.2.4",
    "msw": "^2.11.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
