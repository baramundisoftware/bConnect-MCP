{
  "name": "bconnect-jobs-mcp",
  "version": "26.1.8",
  "private": true,
  "description": "MCP server for bConnect job management (jobs, servermanagement, variables)",
  "type": "module",
  "main": "build/index.js",
  "bin": "build/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mock": "vitest run -c vitest.mock.config.ts",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:performance": "vitest run src/__tests__/performance",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js"
  },
  "keywords": [
    "mcp",
    "baramundi",
    "bconnect",
    "model-context-protocol",
    "jobs",
    "servermanagement",
    "variables"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@bconnect/mcp-core": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.18.1",
    "axios-retry": "^4.5.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.60.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.18.12",
    "@vitest/coverage-v8": "^3.2.4",
    "msw": "^2.11.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
