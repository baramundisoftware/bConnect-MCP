{
  "name": "bconnect-jobs-mcp",
  "version": "26.1.10",
  "description": "MCP server for bConnect job management (jobs, servermanagement, variables)",
  "type": "module",
  "main": "build/index.js",
  "bin": "build/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mock": "vitest run -c vitest.mock.config.ts",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:performance": "vitest run src/__tests__/performance",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js"
  },
  "keywords": [
    "mcp",
    "baramundi",
    "bconnect",
    "model-context-protocol",
    "jobs",
    "servermanagement",
    "variables"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@bconnect/mcp-core": "*",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "axios": "^1.20.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.64.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.11",
    "msw": "^2.11.6",
    "openapi-typescript": "^7.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
