# bConnect API Configuration
# API Documentation: https://your-baramundi-server.example.com/bconnect/docs/
BCONNECT_BASE_URL=https://your-baramundi-server.example.com/bconnect
# The base URL must use https://. http:// is accepted only for this machine
# (localhost, 127.x.x.x, [::1]), e.g. the bundled mock. For another host,
# BCONNECT_ALLOW_INSECURE_HTTP=true allows it, sending credentials unencrypted.
# BCONNECT_ALLOW_INSECURE_HTTP=false

# Authentication — choose one method:
# Option 1: Basic Auth (username + password)
BCONNECT_USERNAME=your-username
BCONNECT_PASSWORD=your-password
# Option 2: API Key (generated in bMS console under Server Management → API Keys)
# BCONNECT_API_KEY=your-api-key

# Release version: 25R2 or 26R1
# Controls which API spec paths and conditional features are used.
BCONNECT_RELEASE=26R1

# Optional: Path to a PEM-encoded CA certificate file used to verify the
# bConnect server's TLS certificate (e.g. a self-signed or internal CA cert).
# Set this instead of disabling TLS verification entirely.
# Example: BCONNECT_CA_CERT_PATH=/etc/ssl/certs/my-internal-ca.pem
BCONNECT_CA_CERT_PATH=

# DEVELOPMENT ONLY — NEVER USE IN PRODUCTION:
# NODE_TLS_REJECT_UNAUTHORIZED=0

## Production Security Settings
# Rate limiting: limits the requests one client sends. Each tool call still creates
# a new client, so the limit doesn't apply across calls yet (#160).
BCONNECT_RATE_LIMIT_ENABLED=false
BCONNECT_RATE_LIMIT_MAX_REQUESTS=100
BCONNECT_RATE_LIMIT_WINDOW_MS=60000

# Audit level: none | security | write | all (any case; levels are cumulative).
# Any other value stops the server. Audit entries go to stderr.
BCONNECT_AUDIT_LEVEL=none


## MCP Transport
# Transport mode: stdio (default, for Claude Desktop / Claude Code) or http (for remote / Docker deployments)
MCP_TRANSPORT=stdio
# HTTP port (only used when MCP_TRANSPORT=http)
# MCP_PORT=3000
