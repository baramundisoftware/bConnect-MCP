{
  "name": "bconnect-compliance-mcp",
  "version": "26.1.8",
  "private": true,
  "description": "MCP server for baramundi bConnect Compliance management (rule violations, vulnerabilities, mobile device rules) — 26R1 only",
  "type": "module",
  "main": "build/index.js",
  "bin": "build/index.js",
  "scripts": {
    "build": "npm run generate:operations:check && tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mock": "vitest run -c vitest.mock.config.ts",
    "test:coverage": "vitest run --coverage",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js",
    "generate:operations": "node scripts/generate-operation-index.mjs",
    "generate:operations:check": "node scripts/generate-operation-index.mjs --check"
  },
  "keywords": [
    "mcp",
    "baramundi",
    "bconnect",
    "model-context-protocol",
    "compliance",
    "vulnerabilities",
    "rule-violations",
    "mobile-device-rules"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@bconnect/mcp-core": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.18.1",
    "axios-retry": "^4.5.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.18.12",
    "@vitest/coverage-v8": "^3.2.4",
    "msw": "^2.11.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
