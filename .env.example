# bConnect MCP Suite — environment configuration (stdio transport, any MCP client)
#
# Copy this file to .env and fill in your values, then run a server with Node
# (e.g. `node bconnect-endpoints-mcp/build/index.js`). See docs/INSTALLATION.md.
# For the HTTP gateway (multi-user / n8n) use .env.gateway.example instead.

# ── bMS Server ────────────────────────────────────────────────────────────────
# REQUIRES baramundi Management Suite 26R1 or later. The servers read the bMS
# version at startup and refuse to run against anything older, because several
# tools depend on routes that only exist from 26R1 on. 25R2 is not supported.
# Your baramundi Management Suite server URL.
BCONNECT_BASE_URL=https://your-baramundi-server.example.com/bconnect

# ── Authentication — choose one method ───────────────────────────────────────
# Option 1: API Key (recommended — generate in bMS console under
#           Server Management → API Keys)
# BCONNECT_API_KEY=your-api-key

# Option 2: Username + Password
BCONNECT_USERNAME=your-username
BCONNECT_PASSWORD=your-password

# ── TLS ───────────────────────────────────────────────────────────────────────
# Path to a PEM-encoded CA certificate for self-signed or internal CA certs.
# Windows:      BCONNECT_CA_CERT_PATH=C:\ProgramData\bConnect-MCP\my-internal-ca.pem
# Linux/macOS:  BCONNECT_CA_CERT_PATH=/etc/ssl/certs/my-internal-ca.pem

# DEVELOPMENT ONLY — NEVER USE IN PRODUCTION:
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ── Optional ──────────────────────────────────────────────────────────────────
# Audit logging level: none | security | write | all
#
# Ships as `write` so a write that was injected or abused is attributable. This
# file previously shipped `none` while CHANGELOG and SECURITY.md both stated the
# default was `write` — true of the per-server samples, false here and in
# docker-compose.gateway.yml, which are the two that govern the network-listening
# gateway. `suite-audit-default.test.ts` now holds all three to the same value.
BCONNECT_AUDIT_LEVEL=write

# Audit records always go to STDERR — never stdout, which on a stdio server is
# the JSON-RPC channel. Set a path here to ALSO append them as JSON Lines, which
# is the only way a stdio deployment gets a persistent audit trail.
# Windows:      BCONNECT_AUDIT_FILE=C:\ProgramData\bConnect-MCP\audit.jsonl
# Linux/macOS:  BCONNECT_AUDIT_FILE=/var/log/bconnect-mcp/audit.jsonl

# Rate limiting. Off by default. Honoured by all 13 servers. Read this before
# turning it on.
#
# It is a per-process token bucket in front of the bConnect client, with no
# queue and no backoff — and BCONNECT_MAX_RETRIES defaults to 0. When the bucket
# empties, the next request THROWS and the tool call fails where it stands,
# which can be halfway through a page walk. On the security tools a walk that
# dies halfway reports fewer findings than the estate has.
#
# It counts HTTP REQUESTS, not tool calls, and one tool call is not one request.
# The composite tools — get_unpatched_endpoints, get_vulnerability_exposure,
# get_security_posture, get_fleet_summary, diagnose_job — fan out into paged
# walks whose length follows the size of YOUR estate, so one question can be
# hundreds of requests on an estate larger than the one you tested against.
#
# 2500 is the sum of the page ceilings one cold get_unpatched_endpoints can
# reach — the CVE-library, detections, endpoint and job-history walks — rounded
# up. That makes it a runaway guard, ~42 requests/second across the window,
# rather than a throttle. There is no value that is both below one composite
# call and useful: set it lower and the first analytical question a customer
# asks dies partway through.
#
# To bound how LONG bConnect is worked rather than how hard, prefer
# BCONNECT_COMPOSITE_BUDGET_MS where the composite supports it: it stops the
# walk on a clock and returns a labelled partial answer instead of an exception.
BCONNECT_RATE_LIMIT_ENABLED=false
BCONNECT_RATE_LIMIT_MAX_REQUESTS=2500
BCONNECT_RATE_LIMIT_WINDOW_MS=60000

# Response cache. Off by default. The cache is per server process and in-memory
# only — an MCP host that restarts the server starts it cold — so keep the TTL
# short enough that a stale read is acceptable for that window.
BCONNECT_CACHE_ENABLED=false
BCONNECT_CACHE_TTL_MS=300000
BCONNECT_CACHE_MAX_SIZE=100
# Cache GET only (default true). Setting false caches write responses too.
BCONNECT_CACHE_GET_ONLY=true

# Batch operations (concurrency control for bulk work). Off by default; no tool
# currently exposes batching, so this only affects code calling executeBatch().
BCONNECT_BATCH_ENABLED=false
BCONNECT_BATCH_CONCURRENCY=5
BCONNECT_BATCH_STOP_ON_ERROR=false
BCONNECT_BATCH_RETRIES=0
BCONNECT_BATCH_RETRY_DELAY_MS=1000

# Debug only: pretty-print tool results. Costs 8-27% of every payload in
# indentation that no model needs. Leave off in production.
BCONNECT_PRETTY_JSON=false

# ── Posture gates ─────────────────────────────────────────────────────────────
# Five variables govern what this suite may do. All are off/absent by default —
# a fresh checkout with none of these set is read-only and cannot touch v1.1.

# Advertise AND enable the suite's create/update/delete/start tools (9 servers,
# 80 tool schemas). With this unset, write tools are hidden from tools/list (a
# token-cost optimization) but still dispatch — a direct call by name is
# refused either way.
# ALLOW_WRITE_OPERATIONS=false

# Narrows ALLOW_WRITE_OPERATIONS to an explicit, comma-separated subset of tool
# names for this process (e.g. assign_job_to_static_group,start_job_instance).
# Implemented in bconnect-jobs-mcp only today — setting it for another
# server's write tools is a silent no-op. Unset changes nothing.
# ALLOWED_WRITE_TOOLS=

# Enable tools that can return BitLocker recovery keys and LAPS passwords
# (bconnect-defensecontrol-mcp). Refused until set to true.
# ALLOW_SECRET_READ=false

# Opt-in to the bConnect v1.1 (SOAP-adjacent) surface used by a handful of
# read tools (preview_assignment, explain_job_failure) and by the Destructive-
# job check below. Also requires BCONNECT_V11_USERNAME/BCONNECT_V11_PASSWORD
# (a domain account, Basic auth, management-LAN only) — without all three, v1.1
# tools are absent from tools/list.
# BCONNECT_ENABLE_V11=false
# BCONNECT_V11_USERNAME=
# BCONNECT_V11_PASSWORD=

# Permits assigning a job the bMS itself flags Destructive (bconnect-jobs-mcp).
# The check that enforces this needs the v1.1 credentials above to read the
# flag at all — without them, the assignment proceeds regardless of this
# variable's value.
# ALLOW_DESTRUCTIVE_JOB_ASSIGNMENT=false

# ── MCP Transport ─────────────────────────────────────────────────────────────
# stdio: default, for any MCP client that launches the server itself
# http:  for single-server HTTP deployments (not needed when using the gateway)
MCP_TRANSPORT=stdio
# MCP_PORT=3000
