# bConnect MCP Suite — environment configuration (stdio / Claude Desktop / Claude Code)
#
# Copy this file to .env and fill in your values, then run a server with Node
# (e.g. `node bconnect-endpoints-mcp/build/index.js`). See docs/INSTALLATION.md.
# For the HTTP gateway (multi-user / n8n) use .env.gateway.example instead.

# ── bMS Server ────────────────────────────────────────────────────────────────
# Your baramundi Management Suite server URL.
BCONNECT_BASE_URL=https://your-baramundi-server.example.com/bconnect

# ── Authentication — choose one method ───────────────────────────────────────
# Option 1: API Key (recommended — generate in bMS console under
#           Server Management → API Keys)
# BCONNECT_API_KEY=your-api-key

# Option 2: Username + Password
BCONNECT_USERNAME=your-username
BCONNECT_PASSWORD=your-password

# ── TLS ───────────────────────────────────────────────────────────────────────
# Path to a PEM-encoded CA certificate for self-signed or internal CA certs.
# BCONNECT_CA_CERT_PATH=/etc/ssl/certs/my-internal-ca.pem

# DEVELOPMENT ONLY — NEVER USE IN PRODUCTION:
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ── bConnect Release ──────────────────────────────────────────────────────────
# Which baramundi Management Suite release to target.
# 26R1: includes compliance and universaldynamicgroups (default)
# 25R2: excludes 26R1-only modules
BCONNECT_RELEASE=26R1

# ── Optional ──────────────────────────────────────────────────────────────────
# Audit logging level: none | security | write | all
BCONNECT_AUDIT_LEVEL=none

# Rate limiting (recommended in production)
BCONNECT_RATE_LIMIT_ENABLED=false
BCONNECT_RATE_LIMIT_MAX_REQUESTS=100
BCONNECT_RATE_LIMIT_WINDOW_MS=60000

# ── MCP Transport ─────────────────────────────────────────────────────────────
# stdio: default, for Claude Desktop / Claude Code
# http:  for single-server HTTP deployments (not needed when using the gateway)
MCP_TRANSPORT=stdio
# MCP_PORT=3000
