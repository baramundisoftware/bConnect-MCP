{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["before 9am on Monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on the first day of the month"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": []
  },
  "packageRules": [
    {
      "description": "Group MCP SDK across all 15 manifests so we don't get 15 separate PRs",
      "matchPackageNames": ["@modelcontextprotocol/sdk"],
      "groupName": "MCP SDK",
      "schedule": ["at any time"]
    },
    {
      "description": "Group axios + axios-retry across all manifests",
      "matchPackageNames": ["axios", "axios-retry"],
      "groupName": "axios"
    },
    {
      "description": "Group OpenAPI tooling",
      "matchPackageNames": ["openapi-fetch", "openapi-typescript"],
      "groupName": "OpenAPI tooling"
    },
    {
      "description": "Group all devDependencies into a single weekly PR",
      "matchDepTypes": ["devDependencies"],
      "groupName": "dev dependencies",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Hold major bumps for review (no auto-grouping)",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major-update"]
    }
  ]
}
