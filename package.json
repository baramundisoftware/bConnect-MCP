{
  "name": "bconnect-mcp-server",
  "version": "26.1.1",
  "description": "Meta package for the bConnect-MCP suite (13 servers + template). Real code lives in bconnect-*-mcp/ subdirectories.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "for d in bconnect-*-mcp bconnect-server-template; do (cd \"$d\" && npm run build) || exit 1; done",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "audit": "for d in . bconnect-*-mcp bconnect-server-template; do echo \"--- $d ---\"; (cd \"$d\" && npm audit --audit-level=high) || true; done"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baramundisoftware/bConnect-MCP.git"
  },
  "keywords": [
    "mcp",
    "baramundi",
    "bconnect",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node-cache": "^4.1.3",
    "axios": "^1.7.0",
    "axios-retry": "^4.5.0",
    "dotenv": "^16.4.0",
    "limiter": "^3.0.0",
    "node-cache": "^5.1.2",
    "openapi-fetch": "^0.12.0",
    "openapi-typescript": "^7.0.0",
    "winston": "^3.18.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.60.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "@vitest/coverage-v8": "^3.2.4",
    "msw": "^2.11.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
