{
  "name": "bconnect-mcp-server",
  "version": "26.1.0",
  "description": "MCP server for baramundi bConnect REST API",
  "type": "module",
  "main": "build/index.js",
  "bin": "build/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:performance": "vitest run src/__tests__/performance",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js",
    "generate-types:25R2": "openapi-typescript /home/ansible/MCP/bConnectOpenAPI/25R2/*.json --output src/generated/25R2/",
    "generate-types:26R1": "openapi-typescript /home/ansible/MCP/bConnectOpenAPI/26R1/*.json --output src/generated/26R1/",
    "generate-types": "npm run generate-types:26R1",
    "pkg": "pkg . --targets node20-win-x64 --output dist/bconnect-mcp.exe --compress GZip",
    "pkg:win": "pkg . --targets node20-win-x64,node20-win-arm64 --output dist/bconnect-mcp-win --compress GZip",
    "pkg:linux": "pkg . --targets node20-linux-x64,node20-linux-arm64 --output dist/bconnect-mcp-linux --compress GZip",
    "pkg:all": "pkg . --targets node20-win-x64,node20-win-arm64,node20-linux-x64,node20-linux-arm64 --compress GZip"
  },
  "pkg": {
    "scripts": "build/**/*.js",
    "assets": [
      "data/**/*",
      ".env.example"
    ],
    "targets": [
      "node20-win-x64",
      "node20-win-arm64",
      "node20-linux-x64",
      "node20-linux-arm64"
    ],
    "outputPath": "dist"
  },
  "keywords": [
    "mcp",
    "baramundi",
    "bconnect",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node-cache": "^4.1.3",
    "axios": "^1.7.0",
    "axios-retry": "^4.5.0",
    "dotenv": "^16.4.0",
    "limiter": "^3.0.0",
    "minisearch": "^7.2.0",
    "node-cache": "^5.1.2",
    "openapi-fetch": "^0.12.0",
    "openapi-typescript": "^7.0.0",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^24.25.0",
    "turndown": "^7.2.1",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.60.0",
    "@types/node": "^22.18.12",
    "@types/turndown": "^5.0.5",
    "@vitest/coverage-v8": "^3.2.4",
    "msw": "^2.11.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
