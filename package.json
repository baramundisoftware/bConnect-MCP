{
  "name": "bconnect-mcp-server",
  "version": "26.1.7",
  "description": "Meta package for the bConnect-MCP suite (13 servers + template). Real code lives in bconnect-*-mcp/ subdirectories.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "bconnect-activedirectory-mcp",
    "bconnect-assets-mcp",
    "bconnect-compliance-mcp",
    "bconnect-defensecontrol-mcp",
    "bconnect-endpoints-mcp",
    "bconnect-groups-mcp",
    "bconnect-jobs-mcp",
    "bconnect-operatingsystems-mcp",
    "bconnect-servermanagement-mcp",
    "bconnect-software-mcp",
    "bconnect-universaldynamicgroups-mcp",
    "bconnect-updatemanagement-mcp",
    "bconnect-variables-mcp",
    "bconnect-server-template"
  ],
  "overrides": {
    "esbuild": "0.28.1",
    "form-data": "^4.0.6",
    "hono": "^4.13.12",
    "js-yaml": "^4.3.2"
  },
  "scripts": {
    "ci": "bash scripts/ci-local.sh",
    "build": "for d in bconnect-*-mcp bconnect-server-template; do (cd \"$d\" && npm run build) || exit 1; done",
    "test": "vitest run",
    "test:live": "vitest run -c vitest.live.config.ts",
    "check:spec": "vitest run __tests__/spec-conformance.guard.test.ts",
    "lint": "eslint \"bconnect-*-mcp/src/**/*.ts\" \"bconnect-server-template/src/**/*.ts\" \"packages/mcp-core/src/**/*.ts\" --max-warnings 0",
    "lint:prune-casts": "eslint \"bconnect-*-mcp/src/**/*.ts\" \"bconnect-server-template/src/**/*.ts\" \"packages/mcp-core/src/**/*.ts\" --prune-suppressions",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "audit": "for d in . bconnect-*-mcp bconnect-server-template; do echo \"--- $d ---\"; (cd \"$d\" && npm audit --audit-level=high) || true; done",
    "sbom": "for d in . bconnect-*-mcp bconnect-server-template bconnect-mcp-gateway; do echo \"--- $d ---\"; (cd \"$d\" && npx @cyclonedx/cyclonedx-npm --output-file sbom.json --spec-version 1.6) || exit 1; done",
    "publish:image": "bash scripts/publish-image.sh",
    "publish:image:dry": "bash scripts/publish-image.sh --dry-run",
    "release": "bash scripts/release.sh",
    "release:dry": "bash scripts/release.sh --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baramundisoftware/bConnect-MCP.git"
  },
  "keywords": [
    "mcp",
    "baramundi",
    "bconnect",
    "model-context-protocol"
  ],
  "author": {
    "name": "baramundi software GmbH",
    "email": "bernd.wiedemann@baramundi.de",
    "url": "https://www.baramundi.com"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "dotenv": "^16.4.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.63.6"
  },
  "devDependencies": {
    "@bconnect/mcp-core": "*",
    "@cyclonedx/cyclonedx-npm": "^6.0.0",
    "@types/node": "^22.20.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^3.2.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.7.0",
    "js-yaml": "^4.3.2",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
