{
  "name": "bconnect-mcp-gateway",
  "version": "26.1.5",
  "description": "Unified MCP gateway — serves all 13 bConnect MCP servers on a single HTTP port",
  "type": "module",
  "main": "build/gateway.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node --import ./build/preload.js build/gateway.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bconnect-activedirectory-mcp": "file:../bconnect-activedirectory-mcp",
    "bconnect-assets-mcp": "file:../bconnect-assets-mcp",
    "bconnect-compliance-mcp": "file:../bconnect-compliance-mcp",
    "bconnect-defensecontrol-mcp": "file:../bconnect-defensecontrol-mcp",
    "bconnect-endpoints-mcp": "file:../bconnect-endpoints-mcp",
    "bconnect-groups-mcp": "file:../bconnect-groups-mcp",
    "bconnect-jobs-mcp": "file:../bconnect-jobs-mcp",
    "bconnect-operatingsystems-mcp": "file:../bconnect-operatingsystems-mcp",
    "bconnect-servermanagement-mcp": "file:../bconnect-servermanagement-mcp",
    "bconnect-software-mcp": "file:../bconnect-software-mcp",
    "bconnect-universaldynamicgroups-mcp": "file:../bconnect-universaldynamicgroups-mcp",
    "bconnect-updatemanagement-mcp": "file:../bconnect-updatemanagement-mcp",
    "bconnect-variables-mcp": "file:../bconnect-variables-mcp",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.18.12",
    "@vitest/coverage-v8": "^3.2.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
