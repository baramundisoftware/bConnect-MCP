# bConnect MCP Gateway — environment configuration
#
# Used with: docker compose -f docker-compose.gateway.yml --env-file .env.gateway up -d
#
# Copy this file to .env.gateway and fill in your values.
# See docs/INSTALLATION.md — Option D and docs/N8N.md for full setup instructions.

# ── bMS Server ────────────────────────────────────────────────────────────────
# Your baramundi Management Suite server URL — shared by all users/tokens.
BCONNECT_BASE_URL=https://your-baramundi-server.example.com/bconnect

# ── TLS ───────────────────────────────────────────────────────────────────────
# Path to a PEM-encoded CA certificate for self-signed or internal CA certs.
# Mount this file into the container — see docker-compose.gateway.yml volumes.
# BCONNECT_CA_CERT_PATH=/etc/ssl/certs/my-internal-ca.pem

# DEVELOPMENT ONLY — NEVER USE IN PRODUCTION:
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ── Token map (multi-user auth) ───────────────────────────────────────────────
# Host path to tokens.json — maps Bearer tokens to bConnect API credentials.
# The file is mounted read-only into the container at /run/secrets/tokens.json.
# See docs/INSTALLATION.md — Option D, Step 2–3 for token generation and format.
#
# When unset, the gateway falls back to single-credential mode using the
# BCONNECT_* fallback vars below.
#
MCP_AUTH_CONFIG_PATH=/etc/mcp/tokens.json

# ── Single-credential fallback ────────────────────────────────────────────────
# Only used when MCP_AUTH_CONFIG_PATH is NOT set (single-credential mode).
# When MCP_AUTH_CONFIG_PATH is set these variables are ignored.
#
# Option 1: API Key (recommended)
# BCONNECT_API_KEY=your-api-key
#
# Option 2: Username + Password
# BCONNECT_USERNAME=your-username
# BCONNECT_PASSWORD=your-password

# ── Gateway network ───────────────────────────────────────────────────────────
# Host port the gateway listens on (container always uses 3001 internally).
MCP_GATEWAY_HOST_PORT=3001

# ── TLS reverse proxy (docker-compose.gateway-tls.yml — ADR-0001) ──────────────
# Public hostname clients connect to; Caddy terminates TLS and proxies to the
# internal gateway. Used only with the -tls overlay.
MCP_GATEWAY_PUBLIC_HOST=mcp-gateway.example.com
# MCP_GATEWAY_TLS_PORT=443
# MCP_GATEWAY_HTTP_PORT=80

# ── Container resource limits (audit H2) ──────────────────────────────────────
MCP_GATEWAY_MEM_LIMIT=512m
MCP_GATEWAY_CPU_LIMIT=1.0
# MCP_CADDY_MEM_LIMIT=128m
# MCP_CADDY_CPU_LIMIT=0.5
