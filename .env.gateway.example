# bConnect MCP Gateway — environment configuration
#
# Used with: docker compose -f docker-compose.gateway.yml --env-file .env.gateway up -d
#
# Copy this file to .env.gateway and fill in your values.
# See docs/INSTALLATION.md and docs/N8N.md for full setup instructions.
#
# ⚠️ The gateway has NO built-in authentication. Front it with a TLS-terminating,
# authenticating reverse proxy before exposing it (see README / docs/DOCKER.md).

# ── bMS Server ────────────────────────────────────────────────────────────────
# Your baramundi Management Suite server URL.
BCONNECT_BASE_URL=https://your-baramundi-server.example.com/bconnect
# It must use https://. http:// is accepted only for the container itself
# (localhost); for any other host, e.g. a test bMS or mock reached through
# host.docker.internal, BCONNECT_ALLOW_INSECURE_HTTP=true allows it and sends
# the credentials unencrypted.
# BCONNECT_ALLOW_INSECURE_HTTP=false

# ── TLS ───────────────────────────────────────────────────────────────────────
# Path to a PEM-encoded CA certificate for self-signed or internal CA certs.
# Mount this file into the container — see docker-compose.gateway.yml volumes.
# BCONNECT_CA_CERT_PATH=/etc/ssl/certs/my-internal-ca.pem
#
# Leave NODE_TLS_REJECT_UNAUTHORIZED unset. A value of 0 turns off certificate
# checks for every bMS call, so anyone in the network path can pose as the bMS
# and receive the service credential. Use BCONNECT_CA_CERT_PATH instead.
# NODE_TLS_REJECT_UNAUTHORIZED=1

# ── bMS release ───────────────────────────────────────────────────────────────
# Which release's tools are registered: 26R1 (default) or 25R2.
# BCONNECT_RELEASE=26R1

# ── Startup check ─────────────────────────────────────────────────────────────
# true skips the connectivity check at startup (not recommended).
# BCONNECT_SKIP_CONNECTIVITY_CHECK=false

# ── bConnect service credential ───────────────────────────────────────────────
# The gateway uses ONE bConnect credential for all downstream calls; bMS RBAC
# governs what it can do, so scope this account to least privilege. (The gateway
# also reads <VAR>_FILE Docker secrets, but this compose file doesn't mount any
# secrets yet, so set the values here.)
#
# Option 1: API Key (recommended)
# BCONNECT_API_KEY=your-service-api-key
#
# Option 2: Username + Password
# BCONNECT_USERNAME=your-username
# BCONNECT_PASSWORD=your-password

# ── Gateway network ───────────────────────────────────────────────────────────
# Host port the gateway listens on (container always uses 3001 internally).
MCP_GATEWAY_HOST_PORT=3001
# Host interface to publish on. Loopback-only by default. Only change this once
# an authenticating reverse proxy is in front of the gateway.
# MCP_GATEWAY_HOST_BIND=127.0.0.1

# ── Inbound rate limiting (per client IP) ─────────────────────────────────────
# Protects the gateway and the downstream bMS from a noisy caller / runaway loop.
# On by default. Tune or disable as needed.
MCP_GATEWAY_RATE_LIMIT_ENABLED=true
MCP_GATEWAY_RATE_LIMIT_MAX=300
MCP_GATEWAY_RATE_LIMIT_WINDOW_MS=60000
# Max accepted request body size (bounds per-request memory).
MCP_GATEWAY_MAX_BODY=1mb

# ── Logging (audit M4) ────────────────────────────────────────────────────────
# LOG_LEVEL: error | warn | info | debug    LOG_FORMAT: text | json
# Use json for ELK/Loki ingestion. A per-request access log is always emitted.
LOG_LEVEL=info
LOG_FORMAT=text

# ── Audit logging ─────────────────────────────────────────────────────────────
# Which tool calls the servers record: none | security | write | all (default: none).
BCONNECT_AUDIT_LEVEL=none

# ── Outbound rate limiting (towards bConnect) ─────────────────────────────────
# Off by default. When on, at most MAX_REQUESTS requests per WINDOW_MS.
# BCONNECT_RATE_LIMIT_ENABLED=false
# BCONNECT_RATE_LIMIT_MAX_REQUESTS=100
# BCONNECT_RATE_LIMIT_WINDOW_MS=60000
# ── Timeout and retries (towards bConnect) ────────────────────────────────────
# Request timeout in ms (1000-600000). Retries for read requests only, after a
# network error, a timeout or HTTP 502/503/504 (0-5); writes are never retried.
# A read can take up to (retries + 1) x the timeout. An invalid value makes
# every tool call report it (the gateway doesn't stop).
# BCONNECT_TIMEOUT_MS=30000
# BCONNECT_MAX_RETRIES=0
# ── TLS / authentication ──────────────────────────────────────────────────────
# The gateway has NO built-in TLS or auth. Front it with a TLS-terminating,
# authenticating reverse proxy of your choice (nginx, Caddy, Traefik, HAProxy,
# or your IdP's application proxy). See docs/DOCKER.md → "TLS and authentication".

# ── Container resource limits (audit H2) ──────────────────────────────────────
MCP_GATEWAY_MEM_LIMIT=512m
MCP_GATEWAY_CPU_LIMIT=1.0

# ── Safety gates ──────────────────────────────────────────────────────────────
# ALLOW_WRITE_OPERATIONS and ALLOW_SECRET_READ are NOT forwarded by
# docker-compose.gateway.yml, so in gateway mode every write tool and every tool
# that returns credentials (BitLocker keys/PIN, LAPS passwords) stays disabled.
# Setting them here has no effect.
