# bConnect MCP Gateway — environment configuration
#
# Used with: docker compose -f docker-compose.gateway.yml --env-file .env.gateway up -d
#
# Copy this file to .env.gateway and fill in your values.
# See docs/INSTALLATION.md and docs/N8N.md for full setup instructions.
#
# ⚠️ MCP_GATEWAY_AUTH_TOKEN below is REQUIRED — the gateway will not start without
# it. It does not terminate TLS, so front it with a TLS-terminating reverse proxy
# before exposing it beyond localhost (see README / docs/DOCKER.md).

# ── bMS Server ────────────────────────────────────────────────────────────────
# Your baramundi Management Suite server URL.
BCONNECT_BASE_URL=https://your-baramundi-server.example.com/bconnect

# ── TLS ───────────────────────────────────────────────────────────────────────
# Path to a PEM-encoded CA certificate for self-signed or internal CA certs.
# Mount this file into the container — see docker-compose.gateway.yml volumes.
# BCONNECT_CA_CERT_PATH=/etc/ssl/certs/my-internal-ca.pem

# DEVELOPMENT ONLY — NEVER USE IN PRODUCTION:
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ── bConnect service credential ───────────────────────────────────────────────
# The gateway uses ONE bConnect credential for all downstream calls; bMS RBAC
# governs what it can do, so scope this account to least privilege. (Values may
# also be supplied from mounted secrets via the *_FILE convention — see secrets.)
#
# Option 1: API Key (recommended)
# BCONNECT_API_KEY=your-service-api-key
#
# Option 2: Username + Password
# BCONNECT_USERNAME=your-username
# BCONNECT_PASSWORD=your-password

# ── Gateway network ───────────────────────────────────────────────────────────
# Host port the gateway listens on (container always uses 3001 internally).
MCP_GATEWAY_HOST_PORT=3001
# Host interface to publish on. Loopback-only by default. Only change this once
# an authenticating reverse proxy is in front of the gateway.
# MCP_GATEWAY_HOST_BIND=127.0.0.1

# ── Inbound rate limiting (per client IP) ─────────────────────────────────────
# Bounds INBOUND MCP calls per client IP. On by default. Tune or disable as
# needed. Note what it does not bound: one MCP tool call can become hundreds of
# bConnect requests, because the composite tools walk paged collections sized to
# the estate. This caps callers, not downstream bMS load.
MCP_GATEWAY_RATE_LIMIT_ENABLED=true
MCP_GATEWAY_RATE_LIMIT_MAX=300
MCP_GATEWAY_RATE_LIMIT_WINDOW_MS=60000
# Max accepted request body size (bounds per-request memory).
MCP_GATEWAY_MAX_BODY=1mb

# ── Logging (audit M4) ────────────────────────────────────────────────────────
# LOG_LEVEL: error | warn | info | debug    LOG_FORMAT: text | json
# Use json for ELK/Loki ingestion. A per-request access log is always emitted.
LOG_LEVEL=info
LOG_FORMAT=text

# ── Audit trail ───────────────────────────────────────────────────────────────
# none | security | write | all. Ships as `write`: the gateway is the only
# component reachable over the network, so its callers are not the local
# operator and an injected or abused write has to be attributable. Records go to
# STDERR (container logs); set BCONNECT_AUDIT_FILE to ALSO append JSON Lines to
# a path for a persistent trail. This file declared nothing at all until
# 2026-08-04, so the compose default was the only thing setting it.
BCONNECT_AUDIT_LEVEL=write
# ── Authentication (REQUIRED) ─────────────────────────────────────────────────
# The gateway requires a bearer token. Every HTTP call must carry
#     Authorization: Bearer <token>
# Without MCP_GATEWAY_AUTH_TOKEN set, the gateway refuses to start rather than
# serving your whole bMS estate unauthenticated. GET /health stays open so
# container healthchecks keep working.
#
# Generate a token — pick whichever is handy:
#   PowerShell   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#   Linux/macOS  openssl rand -base64 32
#   Node         node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# The Windows installer (install/Install-BConnectMcp.ps1, or the UI variant)
# generates this for you and writes it here with restricted file permissions —
# you only need to do it by hand if you are not using the installer.
MCP_GATEWAY_AUTH_TOKEN=

# TO ROTATE: generate a new value, replace it above, restart the gateway
#   (docker compose -f docker-compose.gateway.yml --env-file .env.gateway up -d),
#   then update every client. Old tokens stop working immediately — there is no
#   grace window, so change the clients in the same maintenance slot.
#
# This file now holds a live credential. Keep it out of version control (it is
# already covered by .gitignore) and restrict it on disk:
#   PowerShell   icacls .env.gateway /inheritance:r /grant:r "$env:USERNAME:(R)"
#   Linux/macOS  chmod 600 .env.gateway

# ── TLS ───────────────────────────────────────────────────────────────────────
# The gateway does not terminate TLS. The bearer token above authenticates the
# caller but is sent in a header — over plain HTTP it is readable in transit, so
# anything beyond localhost needs a TLS-terminating reverse proxy in front
# (nginx, Caddy, Traefik, HAProxy, or your IdP's application proxy).
# See docs/DOCKER.md → "TLS and authentication".

# ── Container resource limits (audit H2) ──────────────────────────────────────
MCP_GATEWAY_MEM_LIMIT=512m
MCP_GATEWAY_CPU_LIMIT=1.0
