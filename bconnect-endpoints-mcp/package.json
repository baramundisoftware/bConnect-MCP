{
  "name": "bconnect-endpoints-mcp",
  "version": "26.1.5",
  "description": "MCP server for bConnect endpoint management (endpoints, activedirectory, operatingsystems)",
  "type": "module",
  "main": "build/index.js",
  "bin": "build/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mock": "vitest run -c vitest.mock.config.ts",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:performance": "vitest run src/__tests__/performance",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js"
  },
  "keywords": [
    "mcp",
    "baramundi",
    "bconnect",
    "model-context-protocol",
    "endpoints",
    "activedirectory",
    "operatingsystems"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@bconnect/mcp-core": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node-cache": "^4.1.3",
    "axios": "^1.7.0",
    "axios-retry": "^4.5.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "node-cache": "^5.1.2",
    "openapi-fetch": "^0.12.0",
    "openapi-typescript": "^7.0.0",
    "winston": "^3.18.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.60.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.18.12",
    "@vitest/coverage-v8": "^3.2.4",
    "msw": "^2.11.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
